# ==============================================================================
# ChoirMate AI — Production & Local Development Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend Server (Render / Container Runtime)
# ------------------------------------------------------------------------------

# Port for the Node.js Express server.
# On Render, this is dynamically assigned via $PORT.
# Fallback for local development is 3000.
PORT=3000

# Node runtime environment ('development' | 'production')
NODE_ENV="production"

# Internal URL where the Python OMR & SmolLM2 FastAPI microservice is reachable.
# Inside the container, this is always http://127.0.0.1:5001.
PYTHON_SERVICE_URL="http://127.0.0.1:5001"

# Absolute path to the local open-weight SmolLM2 GGUF model binary.
# Render default: "/tmp/choirmate-models/SmolLM2-360M-Instruct-Q4_K_M.gguf"
# With a Render Persistent Disk mounted at /var/data: "/var/data/models/SmolLM2-360M-Instruct-Q4_K_M.gguf"
SMOLLM2_MODEL_PATH="/tmp/choirmate-models/SmolLM2-360M-Instruct-Q4_K_M.gguf"

# Set to 1 to automatically download the GGUF model from Hugging Face on cold start if not found.
# Set to 0 if the model has already been baked into a persistent disk volume.
SMOLLM2_AUTO_DOWNLOAD="1"

# Allowed CORS origin(s) for cross-origin requests from the Vercel frontend.
# Set to your Vercel deployment URL (e.g. "https://choirmate-ai.vercel.app") or "*" for all origins.
CORS_ORIGIN="*"

# Optional: AssemblyAI Speech-to-Text API Key (Server-Side Only).
# Used strictly for transcribing spoken questions after explicit user consent.
# If left empty, ChoirMate AI functions normally with typed Q&A and 100% local OMR and audio synthesis.
ASSEMBLYAI_API_KEY=""

# Application public base URL
APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. Frontend Client (Vercel Deployment / Vite)
# ------------------------------------------------------------------------------

# Optional direct Render backend URL for the Vercel frontend client.
# Example: "https://choirmate-backend.onrender.com"
# If unset, the frontend defaults to same-origin "/api" routes proxied via vercel.json.
# Setting this directly is recommended for multi-page PDF uploads exceeding Vercel's 4.5MB edge limit.
VITE_API_URL=""
